{
  "name": "nextexplorer",
  "version": "1.0.8",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:browser": "node scripts/browser-test.mjs",
    "test:layout": "node scripts/browser-test.mjs --layout-only",
    "test:tags": "node scripts/browser-test.mjs --tags-only",
    "test:space": "node scripts/browser-test.mjs --space-only",
    "test:console": "node scripts/browser-test.mjs --console-only",
    "test:remote": "node scripts/browser-test.mjs --remote-only",
    "test:console:extension": "node scripts/console-extension-test.mjs",
    "test:connection:extension": "node scripts/console-extension-test.mjs --setup",
    "test:extension": "node scripts/extension-test.mjs",
    "test:mcp:extension": "node scripts/console-extension-test.mjs --mcp",
    "native:licenses": "node scripts/native-licenses.mjs",
    "test:j5:worker": "node scripts/j5-worker-journey.mjs",
    "test:j5:extension": "node scripts/j5-extension-journey.mjs",
    "test:finder:extension": "node scripts/j5-extension-journey.mjs --finder-only",
    "test:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-install-host.ps1",
    "test:diagnostic": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-diagnose-host.ps1",
    "test:repair": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-repair-host.ps1",
    "test:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-setup-host.ps1",
    "test:setup:acceptance": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-setup-acceptance.ps1",
    "setup:acceptance": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-setup-acceptance.ps1",
    "setup:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-setup.ps1",
    "native:build": "node scripts/native.mjs build",
    "native:test": "node scripts/native.mjs test",
    "package": "npm run build && npm run native:build && node scripts/package.mjs && node scripts/verify-package.mjs",
    "package:store": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-store.ps1",
    "test:store": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-package-store.ps1",
    "test:store:extension": "node scripts/console-extension-test.mjs --store",
    "format": "prettier --write src scripts/*.mjs public/*.js *.json vite.config.ts",
    "check": "tsc -b && vitest run",
    "check:identity": "node scripts/extension-identity.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@tanstack/react-virtual": "^3.13.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.11.0",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.313",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "playwright": "^1.56.0",
    "prettier": "^3.6.0",
    "typescript": "~5.8.3",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  }
}
