{
  "manifest_version": 3,
  "name": "NextExplorer — Explorateur local",
  "version": "1.0.0",
  "description": "Explorez et préparez vos fichiers locaux depuis Chrome. Compagnon Windows requis.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "nativeMessaging",
    "storage",
    "contextMenus",
    "sidePanel",
    "tabs",
    "tabGroups",
    "activeTab",
    "scripting"
  ],
  "optional_permissions": [
    "debugger",
    "downloads"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Ouvrir NextExplorer"
  },
  "side_panel": {
    "default_path": "index.html?panel=1"
  },
  "commands": {
    "open-explorer": {
      "suggested_key": {
        "default": "Alt+E"
      },
      "description": "Ouvrir le panneau explorateur"
    },
    "open-dashboard": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Ouvrir en pleine page"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https: http:; img-src 'self' data: blob: https: http:; media-src 'self' blob: data: http://127.0.0.1:*; frame-src 'self' blob:"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
